<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's fallback image: the card the widget is drawn on, with the accent bar the word sits above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/widget_today_background" />
    <item
        android:bottom="36dp"
        android:gravity="bottom|center_horizontal"
        android:width="48dp"
        android:height="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_accent" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
