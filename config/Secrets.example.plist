<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE for the production AdMob unit IDs. Copy to nihongo/Secrets.plist
  (git-ignored) and fill in your real ca-app-pub-XXXX/YYYY banner units.
  Without this file the app falls back to Google's public TEST banner
  (AdConfig.testBanner) — safe, shows test ads, commits no secrets.
  Slot keys match AdSlot.rawValue in nihongo/Ads/AdConfig.swift.
-->
<plist version="1.0">
<dict>
	<key>banners</key>
	<dict>
		<key>kana</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000001</string>
		<key>lessons</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000002</string>
		<key>select-mode</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000003</string>
		<key>vocab-list</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000004</string>
		<key>search</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000005</string>
		<key>about</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000006</string>
		<!-- Today tab. Required: there is no alias any more, and a missing key means
		     Google's public TEST banner on the landing tab of a production build. -->
		<key>today</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000008</string>
		<!-- Progress tab. Split from `today` so the two screens report separately. -->
		<key>progress</key>
		<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000009</string>
	</dict>
	<!-- Full-screen popup shown after a Quiz (RN's assessment-popup). Omit to use the test unit. -->
	<key>interstitial</key>
	<string>ca-app-pub-XXXXXXXXXXXXXXXX/0000000007</string>
</dict>
</plist>
