default_platform(:ios)

# `ta` is NOT uploaded to App Store Connect, by decision — don't chase it as a bug. Its
# text under fastlane/metadata/ta is written and current; it just has nowhere to go.
#
# Two independent reasons, and the second is the blocking one:
#
# 1. `deliver` drops it. `Deliver::Loader` partitions locale folders on `valid?`, which
#    tests against the hardcoded `Deliver::Languages::ALL_LANGUAGES` list, and that list
#    has no `ta`. `ignore_language_directory_validation: true` only silences the resulting
#    error — the folder is still discarded, so the text is never even loaded. Easy to
#    mistake for a successful run: the lane reports success having skipped it.
# 2. It doesn't exist as a localization on the App Store version, so there is no
#    destination to write to even going around fastlane via `Spaceship::ConnectAPI`.
#
# To actually ship it: add Tamil in App Store Connect first, then either upgrade fastlane
# past its stale language list or push with Spaceship directly. Until someone wants that
# market enough to do that, the folder is inert reference copy.
#
# `fil` was in exactly this state and has been removed outright — metadata and rendered
# screenshots both. Filipino store copy is recoverable from git history if it's ever
# wanted; don't reintroduce the folder without adding the localization in ASC first.

# App Store Connect API key. Credentials come from the git-ignored fastlane/.env
# (copy fastlane/.env.example). The .p8 itself lives outside the repo.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
  )
end

platform :ios do
  desc "Upload + publish App Privacy details (nutrition labels). Interactive: this
        rides Apple's private web API, so it asks for your Apple ID password + 2FA."
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      username: "kf@voltra.org",
      app_identifier: "com.kfpun.nihongo",
      json_path: "fastlane/app_privacy_details.json",
    )
  end

  desc "Push App Store text metadata (all localizations) — no binary, no screenshots"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      # Suppresses the *error* for locale folders fastlane doesn't recognise — it does not
      # make them upload. `ta` is deliberately not uploaded: see the note at the
      # top of this file.
      ignore_language_directory_validation: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      overwrite_screenshots: false,
      sync_screenshots: false,
      force: true,                 # skip the HTML confirmation prompt
      run_precheck_before_submit: false,
      submit_for_review: false,
    )
  end

  desc "Archive + upload a new build to App Store Connect. No metadata/screenshots
        touched, no submission — the build lands in TestFlight/ASC processing and
        a human decides when (and whether) to submit it for review."
  lane :release do
    build_app(
      scheme: "nihongo",
      export_method: "app-store",
      output_directory: "build",
    )
    upload_to_app_store(
      api_key: asc_api_key,
      # Suppresses the *error* for locale folders fastlane doesn't recognise — it does not
      # make them upload. `ta` is deliberately not uploaded: see the note at the
      # top of this file.
      ignore_language_directory_validation: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,                 # skip the HTML confirmation prompt
      run_precheck_before_submit: false,
    )
  end

  desc "Push App Store screenshots (draft metadata only) — no binary, no text metadata, no submission"
  lane :screenshots do
    deliver(
      api_key: asc_api_key,
      screenshots_path: "fastlane/screenshots",
      # Suppresses the *error* for locale folders fastlane doesn't recognise — it does not
      # make them upload. `ta` is deliberately not uploaded: see the note at the
      # top of this file.
      ignore_language_directory_validation: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      sync_screenshots: false,
      force: true,                 # skip the HTML confirmation prompt
      run_precheck_before_submit: false,
      submit_for_review: false,
    )
  end
end
