
# Generated by scripts/build-minna-data.py from the `minna` submodule
# (regenerate any time with `make data`).
nihongo/Resources/MinnaData.json
nihongo/Resources/KanaChart.json
nihongo/Resources/audio/

# Generated by scripts/build-jlpt-data.py from the same submodule's `jlpt/` half.
Apps/jlpt/Resources/JLPTData.json
Apps/jlpt/Resources/audio/

# Secrets — real Firebase + AdMob values. Never commit; see config/*.example.plist
# and copy the real files into nihongo/ (bundled by the synchronized group).
nihongo/GoogleService-Info.plist
nihongo/Secrets.plist

# The JLPT app's own Firebase app, in the same kf-nihongo project. A separate file,
# not a copy: its BUNDLE_ID is com.kfpun.jlptjp, and `AppDelegate` starts Firebase
# only when a plist is bundled — so the two apps report separately or not at all,
# never into each other.
Apps/jlpt/GoogleService-Info.plist

# App Store Connect API keys — never commit (kept in ~/.appstoreconnect/private_keys/)
*.p8

# Fastlane: credentials (.env) and generated artifacts. Metadata under fastlane/metadata/ IS committed.
.env
fastlane/.env
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/

# Xcode build artifacts & per-user state
build/
DerivedData/
*.xcuserstate
**/xcuserdata/
.DS_Store

# Ruby / Bundler (Fastlane) local install
vendor/
.bundle/

# Firebase Hosting deploy cache
.firebase/

# App Store screenshot pipeline. Both the raw captures (fastlane/screenshot_raw/)
# and the generated uploads (fastlane/screenshots/) are tracked, so the exact
# listing imagery is reproducible from a clean clone — the raw ones especially,
# since re-capturing needs a specific simulator + iOS version and the UI drifts.
# Regenerate the uploads with fastlane/generate_framed_screenshots.py. Device frame
# PNGs stay ignored: they're a cache auto-downloaded from fastlane's own public
# frameit-frames CDN (see ensure_frame()).
fastlane/screenshot_frames/
scripts/__pycache__/
fastlane/__pycache__/

# CodeGraph local index
.codegraph/

# Firebase CLI debug output (written into the repo root by `firebase deploy`)
firebase-debug.log
firestore-debug.log
