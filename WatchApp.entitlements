<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Watch app entitlements: the same App Group id as iOS, but on watchOS it resolves to
     a separate container shared only with the watch widget extension. That container is
     how the complications see the snapshot WatchConnectivity delivered here. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kfpun.nihongo</string>
	</array>
</dict>
</plist>
