<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Attest, used by Firebase App Check to prove a Firestore survey write came
	  from a genuine build (see SurveyAppCheckFactory in Ads/AppBootstrap.swift).

	  "production", not Xcode's default "development": Debug and Release share this
	  one entitlements file (CODE_SIGN_ENTITLEMENTS in both configs), so only one
	  value can ship — and it has to be the one TestFlight/App Store builds need,
	  or attestation fails there and App Check rejects every write. Nothing is lost
	  locally because DEBUG doesn't use App Attest at all: the factory returns
	  AppCheckDebugProvider instead, which authenticates with a token registered in
	  the Firebase console.
	-->
	<!--
	  Push. "development" is wrong here for the same reason App Attest above is
	  "production": Debug and Release share one entitlements file, so only one value
	  can ship, and it has to be the one TestFlight and the App Store need. APNs
	  accepts a production token from a development build, so nothing is lost locally.

	  Requires the Push Notifications capability on this App ID in the developer
	  portal — without it, signing fails rather than push silently not working.
	-->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.kfpun.nihongo</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kfpun.nihongo</string>
		<!--
		  OneSignal's own group, shared with the OneSignalNSE extension so the app and
		  the extension agree on badge counts and delivery receipts. Separate from the
		  group above on purpose: that one holds the Today deck the widget and watch app
		  read, and giving a third-party SDK write access to it is how a widget starts
		  showing a stale word for reasons nobody can trace.
		-->
		<string>group.com.kfpun.nihongo.onesignal</string>
	</array>
</dict>
</plist>
