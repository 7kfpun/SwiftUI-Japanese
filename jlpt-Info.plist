<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Required by OneSignal for Confirmed Delivery and for the Notification Service
	  Extension to run at all. It does NOT let the app run in the background generally
	  — it lets APNs wake it briefly to process an incoming notification.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  OneSignal App ID for JLPT Daily — dashboard → Settings → Keys & IDs.
	  Public by design: it ships in the binary and identifies the app to OneSignal. It is
	  NOT the REST API key, which is secret and must never live here.

	  Distinct from Minna's ID in Info.plist, and they must never be shared: one ID means
	  one subscriber list, so a JLPT campaign would land on Minna's users too. Blank here
	  makes PushService skip OneSignal entirely, which is the honest state for an app
	  that has no OneSignal project yet.
	-->
	<key>OneSignalAppID</key>
	<string>24ad4d16-fe36-47cc-896b-3c63d769c348</string>
	<!--
	  Firebase must NOT swizzle the app delegate. FCM and OneSignal both swizzle by
	  default, and both want the same two things: the APNs device token, and
	  UNUserNotificationCenter.delegate. Left to fight over them, whichever loses
	  goes quiet — with no error, on device only, usually noticed as "a campaign
	  went out and nobody got it".

	  With the proxy off, PushService owns both and hands the token to each SDK
	  explicitly. Do not set this back to YES without removing one of them.
	-->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<!-- Without this the home screen reads "jlpt", the target name. -->
	<key>CFBundleDisplayName</key>
	<string>Bonsai JLPT</string>

	<!-- Distinct from nihongo's `nihongo://`: iOS resolves a scheme claimed by two
	     apps arbitrarily, so a shared one would let either app open the other's links. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kfpun.jlptjp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jlpt</string>
			</array>
		</dict>
	</array>

	<!-- REAL: Google's public *test* app ID. It cannot be omitted —
	     `AppDelegate` calls MobileAds.shared.start() unconditionally and the SDK
	     raises at launch without this key — and it must not be nihongo's, which
	     would file this app's impressions under the Minna app. Replace once the
	     JLPT app exists in AdMob. Ad *unit* IDs need no placeholder: `AdConfig`
	     already falls back to Google's public test units when Secrets.plist is
	     absent, and it is absent here by design.

	     Xcode's plist editor strips these comments whenever it rewrites the file,
	     so this warning also lives in the plan's Phase 4 notes. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-8610011634603119~9542527647</string>

	<!-- Omitting this makes App Store Connect ask about export compliance on every
	     single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The handwriting scoring template face (`Theme.jpStrokes`) — functional, not
	     decorative: `KanaWriteView` draws its stroke-order glyph from it. -->
	<key>UIAppFonts</key>
	<array>
		<string>KanjiStrokeOrders_v4.005.ttf</string>
	</array>
</dict>
</plist>
